# Database: ค่าเริ่มต้นตรงกับ Docker Compose สามารถเปลี่ยนก่อนเริ่มระบบครั้งแรก
MYSQL_DATABASE=it_asset_db
MYSQL_USER=it_asset_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# ใช้เฉพาะเมื่อฐานข้อมูลยังไม่มีบริษัทเลย
INITIAL_COMPANY_CODE=COMPANY
INITIAL_COMPANY_NAME=Company Name

# ใช้เฉพาะตอนระบบจำเป็นต้องสร้างบัญชี ADMIN-001 ครั้งแรก
DEFAULT_LOGIN_PASSWORD=change_me_now

# อายุ Session หน่วยชั่วโมง
SESSION_TTL_HOURS=12

# URL สาธารณะสำหรับ QR (ไม่บังคับ หากเว้นว่างระบบใช้ URL ที่เปิดหน้าเว็บ)
VITE_PUBLIC_APP_URL=
